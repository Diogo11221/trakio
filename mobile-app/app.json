{
  "expo": {
    "name": "Trakio",
    "slug": "trakio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trakio",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "pt.trakio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pt.trakio.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "O Trakio usa o microfone para registares refeições por voz."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4FF00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Trakio usa as tuas fotografias para as enviares ao teu PT ou aluno.",
          "cameraPermission": "O Trakio usa a câmara para fotografares refeições e enviares fotos ao teu PT ou aluno."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0C0E"
  }
}
