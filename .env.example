# Copy to .env (never commit it) and fill in. Used by docker.compose.yml.

# Database
POSTGRES_PASSWORD=change-me

# "dev" = fake payments + demo accounts; "prod" = Stripe, everything required below.
SPRING_PROFILES_ACTIVE=dev

# 32+ random bytes, base64: openssl rand -base64 48 (required with prod)
TRAKIO_JWT_SECRET=

# Comma-separated origins allowed by CORS (web admin, landing page)
TRAKIO_CORS_ORIGINS=http://localhost:5173

# First admin account (only used while no admin exists; remove afterwards). Password: 12+ characters.
TRAKIO_BOOTSTRAP_ADMIN_EMAIL=
TRAKIO_BOOTSTRAP_ADMIN_PASSWORD=

# Stripe (prod)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_MARKETPLACE_PRICE_ID=
